<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="OutdoorActivityButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">58dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:background">@drawable/bg_activity_item</item>
        <item name="android:button">@null</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="SocialIconButton" parent="Widget.MaterialComponents.Button">
        <item name="iconTint">@null</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">28dp</item>
        <item name="iconGravity">textStart</item>
    </style>


    <style name="ForecastDetailCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">88dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/bg_forecast_detail</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">10dp</item>
        <item name="android:textColor">#EDEDED</item>
        <item name="android:textSize">13sp</item>
    </style>

</resources>