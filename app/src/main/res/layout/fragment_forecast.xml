<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/forecastScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#181818"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="110dp">

        <!-- Header -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Weather Forecast"
                    android:textColor="#F5F5F5"
                    android:textSize="25sp"
                    android:textStyle="bold" />



                <TextView
                    android:id="@+id/tvForecastUpdated"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Last updated: --"
                    android:textColor="#727272"
                    android:textSize="11sp" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/btnRefreshForecast"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Refresh forecast"
                android:padding="10dp"
                android:src="@drawable/ic_refresh"
                app:tint="#F5F5F5" />

        </LinearLayout>

        <!-- Loading -->

        <ProgressBar
            android:id="@+id/progressForecast"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:indeterminateTint="#818181"
            android:visibility="gone" />

        <!-- Error message -->

        <TextView
            android:id="@+id/tvForecastError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#332020"
            android:gravity="center"
            android:padding="12dp"
            android:textColor="#FF7979"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Current summary -->



        <!-- Weather alert -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardWeatherAlert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#342622"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#80543D"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="15dp">

                <TextView
                    android:id="@+id/tvAlertIcon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="⚠️"
                    android:textSize="22sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvAlertTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Weather alert"
                        android:textColor="#FFD36A"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAlertMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="#D3C1B8"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Outdoor window -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardOutdoorWindow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#282330"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#005F456E"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BEST OUTDOOR WINDOW"
                    android:textColor="#fff"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOutdoorWindowTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Calculating..."
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOutdoorWindowReason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Analyzing rain, temperature, humidity and wind."
                    android:textColor="#B7AFBB"
                    android:textSize="12sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 7-day forecast -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="7-Day Forecast"
            android:textColor="#F5F5F5"
            android:textSize="17sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDailyForecast"
            android:layout_width="match_parent"
            android:layout_height="172dp"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingEnd="8dp" />

        <!-- Weather timeline -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Weather Timeline"
            android:textColor="#F5F5F5"
            android:textSize="17sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#00252525"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#00383838"
            app:strokeWidth="1dp">

            <LinearLayout
                android:id="@+id/layoutWeatherTimeline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="6dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvWeatherTimelineEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="#00FFFFFF"
                    android:gravity="center"
                    android:padding="20dp"
                    android:text="Weather changes will appear here."
                    android:textColor="#8D8D8D"
                    android:textSize="12sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>






        <!-- Weather details -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Weather Details"
            android:textColor="#F5F5F5"
            android:textSize="17sp"
            android:textStyle="bold" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:alignmentMode="alignMargins"
            android:columnCount="2"
            android:rowCount="3"
            android:useDefaultMargins="false">

            <TextView
                android:id="@+id/tvDetailFeelsLike"
                android:layout_width="0dp"
                android:layout_height="84dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_dashboard_panel"
                android:gravity="center"
                android:padding="10dp"
                android:text="Feels like\n--°"
                android:textAlignment="center"
                android:textColor="#F2F2F2"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvDetailHumidity"
                android:layout_width="0dp"
                android:layout_height="84dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_dashboard_panel"
                android:gravity="center"
                android:padding="10dp"
                android:text="Humidity\n--%"
                android:textAlignment="center"
                android:textColor="#F2F2F2"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvDetailWind"
                android:layout_width="0dp"
                android:layout_height="84dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_dashboard_panel"
                android:gravity="center"
                android:padding="10dp"
                android:text="Wind\n-- km/h"
                android:textAlignment="center"
                android:textColor="#F2F2F2"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvDetailVisibility"
                android:layout_width="0dp"
                android:layout_height="84dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_dashboard_panel"
                android:gravity="center"
                android:padding="10dp"
                android:text="Visibility\n-- km"
                android:textAlignment="center"
                android:textColor="#F2F2F2"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvDetailUvIndex"
                android:layout_width="0dp"
                android:layout_height="84dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_dashboard_panel"
                android:gravity="center"
                android:padding="10dp"
                android:text="UV index\n--"
                android:textAlignment="center"
                android:textColor="#F2F2F2"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvDetailSunriseSunset"
                android:layout_width="0dp"
                android:layout_height="84dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_dashboard_panel"
                android:gravity="center"
                android:maxLines="3"
                android:padding="8dp"
                android:text="Sunrise / Sunset\n-- / --"
                android:textAlignment="center"
                android:textColor="#F2F2F2"
                android:textSize="11sp" />

        </GridLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
