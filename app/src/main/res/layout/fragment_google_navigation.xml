<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#202020">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/googleNavigationContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />




    <ProgressBar
        android:id="@+id/progressNavigation"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="center"
        android:indeterminateTint="#C65CF4"
        android:visibility="visible" />

    <!-- Back button -->

    <TextView
        android:id="@+id/btnBackNavigation"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:background="@drawable/bg_onboarding_input"
        android:contentDescription="Back"
        android:elevation="10dp"
        android:gravity="center"
        android:text="←"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold" />


    <!-- Current weather status -->

    <LinearLayout
        android:id="@+id/navigationWeatherStatus"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/bg_onboarding_input"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/tvNavigationWeatherIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☁"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvNavigationWeather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Checking weather…"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Weather warning banner -->

    <LinearLayout
        android:id="@+id/weatherWarningPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="16dp"
        android:layout_marginTop="68dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_onboarding_input"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠"
            android:textSize="24sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvWeatherWarningTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Weather warning"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWeatherWarningMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Rain detected along your current location."
                android:textColor="#E0E0E0"
                android:textSize="12sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/btnDismissWeatherWarning"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="Dismiss warning"
            android:gravity="center"
            android:text="×"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />

    </LinearLayout>

</FrameLayout>