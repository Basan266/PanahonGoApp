<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardHourlyForecast"
    android:layout_width="82dp"
    android:layout_height="138dp"
    android:layout_marginEnd="9dp"
    app:cardBackgroundColor="#00252525"
    app:cardCornerRadius="17dp"
    app:cardElevation="0dp"
    app:strokeColor="#383838"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="9dp">

        <TextView
            android:id="@+id/tvHourlyTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="Now"
            android:textColor="#B8B8B8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivHourlyWeatherIcon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginTop="5dp"
            android:contentDescription="Hourly weather condition"
            android:padding="3dp"
            android:scaleType="fitCenter"
            app:tint="@null" />

        <TextView
            android:id="@+id/tvHourlyTemperature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="31°"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💧"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvHourlyRainChance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="40%"
                android:textColor="#76C9FF"
                android:textSize="10sp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>